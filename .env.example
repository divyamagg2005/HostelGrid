# Django Settings
SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=False

# Database Configuration (Supabase PostgreSQL)
SUPABASE_HOST=your-supabase-host.pooler.supabase.com
SUPABASE_DB_NAME=postgres
SUPABASE_USER=postgres.your-project-id
SUPABASE_PASSWORD=your-database-password
SUPABASE_PORT=6543

# Allowed Hosts (comma-separated, add your Render domain)
# Example: ALLOWED_HOSTS=your-app.onrender.com,localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# Python Version
PYTHON_VERSION=3.11.0
